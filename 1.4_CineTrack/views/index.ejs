<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CineTrack</title>
</head>

<body>
    <h1>Welcome to my CineTrack</h1>
    <p>Track your favorite movies!</p>

    <% movies.forEach(movie=> { %>

        <h2>
            <%= movie.title %>
        </h2>
        <p>
            <%= movie.year %>
        </p>
        <p>
            <%= movie.genre %>
        </p>
        <p>⭐ <%= movie.rating %>/10</p>

        <% if (movie.watched) { %>
            <p>Watched</p>
            <% } else { %>
                <p>Watching list</p>
                <% } %>

                    <% }); %>
</body>

</html>