<!DOCTYPE html>
<html lang="en">

<head>
    <link rel="stylesheet" href="/styles.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CineTrack</title>
</head>
<div class="app">


    <aside class="sidebar">

        <div class="logo">
            <div class="logo-icon">
                <i class="bi bi-film"></i>
            </div>
            <div class="logo-text">
                <h2>CineTrack</h2>
                <p>Movie Tracker</p>
            </div>

        </div>

        <div class="stats">
            <div>
                <span>Total</span>
                <strong>2</strong>
            </div>

            <div>
                <span>Watched</span>
                <strong>1</strong>
            </div>

            <div>
                <span>Watchlist</span>
                <strong>1</strong>
            </div>
        </div>

        <nav>

            <a href="/" class="active">
                <i class="bi bi-house"></i>
                <span>Home</span>
            </a>

            <a href="#">
                <i class="bi bi-clock"></i>
                <span>Watchlist</span>
            </a>

            <a href="#">
                <i class="bi bi-check-circle"></i>
                <span>Watched</span>
            </a>

            <a href="#">
                <i class="bi bi-list-task"></i>
                <span>Lists</span>
            </a>

            <a href="#">
                <i class="bi bi-gear"></i>
                <span>Settings</span>
            </a>

        </nav>

    </aside>


    <main class="main">
        <h1>Welcome to my CineTrack</h1>
    </main>

</div>

<body>
    <p>Track your favorite movies!</p>

    <% movies.forEach(movie=> { %>

        <h2>
            <%= movie.title %>
        </h2>
        <p>
            <%= movie.year %>
        </p>
        <p>
            <%= movie.genre %>
        </p>
        <p>⭐ <%= movie.rating %>/10</p>

        <% if (movie.watched) { %>
            <p>Watched</p>
            <% } else { %>
                <p>Watching list</p>
                <% } %>

                    <% }); %>
</body>

</html>